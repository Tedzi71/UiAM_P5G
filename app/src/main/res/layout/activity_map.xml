<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/card_background_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Return to History"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Session Coverage"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCurrentMetricSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Layer: SS-RSRP Coverage"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOptionsMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Map Options"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_primary_dark" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider_subtle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- OpenStreetMap View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!-- Vertical Color Legend on the Right Side -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVerticalLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/card_background_dark"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvLegendMetricName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="SS-RSRP"
                android:textColor="@color/text_primary_dark"
                android:textSize="11sp" />

            <!-- Level 1 (Excellent) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <View
                    android:id="@+id/viewColor1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_5g"
                    android:backgroundTint="@color/color_excellent" />

                <TextView
                    android:id="@+id/tvLegendVal1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="> -80"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Level 2 (Good) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <View
                    android:id="@+id/viewColor2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_5g"
                    android:backgroundTint="@color/color_good" />

                <TextView
                    android:id="@+id/tvLegendVal2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="-90"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Level 3 (Mid) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <View
                    android:id="@+id/viewColor3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_5g"
                    android:backgroundTint="@color/color_mid" />

                <TextView
                    android:id="@+id/tvLegendVal3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="-100"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Level 4 (Poor) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <View
                    android:id="@+id/viewColor4"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_5g"
                    android:backgroundTint="@color/color_poor" />

                <TextView
                    android:id="@+id/tvLegendVal4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="-110"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Level 5 (Bad) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <View
                    android:id="@+id/viewColor5"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_5g"
                    android:backgroundTint="@color/color_bad" />

                <TextView
                    android:id="@+id/tvLegendVal5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="&lt; -110"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Fit Route Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFitTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Fit Route on Screen"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/card_background_dark"
        app:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@id/cardTelemetryPopup"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/primary" />

    <!-- Clickable Marker Telemetry Detail Popup Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelemetryPopup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/card_background_dark"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPopupTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Sample Telemetry"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnClosePopup"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Details"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPopupTimestampCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Timestamp | Lat: --, Lon: --"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider_subtle" />

            <!-- Radio details -->
            <TextView
                android:id="@+id/tvPopupRadioDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G SA | Band -- | PCI: --"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPopupSignalDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="SS-RSRP: -- dBm | SS-SINR: -- dB"
                android:textColor="@color/color_excellent"
                android:textSize="13sp" />

            <!-- QoS details -->
            <TextView
                android:id="@+id/tvPopupQosDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5G GW: Latency -- ms | Jitter -- ms | Loss --%"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>