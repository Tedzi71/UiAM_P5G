<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/card_background_dark"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSessionName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Session_Name_1"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDominantNetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_5g"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="5G SA"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Date & Sample Count -->
        <TextView
            android:id="@+id/tvSessionDateDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026-11-20 21:00 | 12m 45s | 148 Samples"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/card_border" />

        <!-- Aggregated Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg RSRP"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvAvgRsrp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-86 dBm"
                    android:textColor="@color/color_good"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg SINR"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvAvgSinr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14.2 dB"
                    android:textColor="@color/color_good"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GW Latency"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvAvgLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11.8 ms"
                    android:textColor="@color/color_excellent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max DL"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMaxDl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Mbps"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/card_border" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewOnMap"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/accent_5g"
                android:padding="0dp"
                android:text="VIEW ON MAP"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnExportCsv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="CSV"
                android:textColor="@color/accent_5g"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp"
                app:strokeColor="@color/accent_5g" />

            <Button
                android:id="@+id/btnExportGeoJson"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:padding="0dp"
                android:text="GEOJSON"
                android:textColor="@color/accent_5g"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="6dp"
                app:strokeColor="@color/accent_5g" />

            <ImageButton
                android:id="@+id/btnDeleteSession"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android.drawable/ic_menu_delete"
                app:tint="@color/color_bad" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
