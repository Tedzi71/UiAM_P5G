<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Map Color Thresholds"
            android:textColor="@color/accent_5g"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Adjust the bounds for 3GPP color classifications on the coverage map."
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/card_border" />

        <!-- RSRP Thresholds -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SS-RSRP Thresholds (dBm)"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Green (>)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRsrpExcellent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:text="-80"
                    android:textColor="@color/color_excellent" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Yellow (Mid)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRsrpMid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:text="-100"
                    android:textColor="@color/color_mid" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Red (&lt;)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRsrpPoor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:text="-110"
                    android:textColor="@color/color_bad" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Latency Thresholds -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="5G Gateway Latency Thresholds (ms)"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Green (&lt;)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLatExcellent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="15"
                    android:textColor="@color/color_excellent" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Yellow (Mid)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLatMid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="30"
                    android:textColor="@color/color_mid" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Red (>)"
                android:textColorHint="@color/text_secondary_dark"
                app:boxBackgroundColor="@color/background_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLatPoor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="60"
                    android:textColor="@color/color_bad" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
