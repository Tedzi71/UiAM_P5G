<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="SETTINGS &amp; CONFIGURATION"
            android:textColor="@color/accent_5g"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 0. App Theme Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP THEME"
                    android:textColor="@color/accent_5g"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toggle between Dark and Bright (Light) theme"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleThemeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnThemeDark"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="🌙 Dark Theme"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:strokeColor="@color/card_border" />

                    <Button
                        android:id="@+id/btnThemeBright"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="☀️ Bright Theme"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:strokeColor="@color/card_border" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <Button
                    android:id="@+id/btnToggleTheme"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/accent_5g"
                    android:text="SWITCH TO BRIGHT THEME"
                    android:textColor="@color/color_accent_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Gateway Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5G GATEWAY (LATENCY TARGET)"
                    android:textColor="@color/accent_5g"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoGateway"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Auto-detect Cellular Default Gateway (UPF)"
                    android:textColor="@color/text_primary_dark"
                    app:thumbTint="@color/accent_5g"
                    app:trackTint="@color/primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilManualGateway"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Manual Gateway / UPF IP"
                    android:textColorHint="@color/text_secondary_dark"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/background_dark"
                    app:boxStrokeColor="@color/accent_5g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etManualGatewayIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:text="10.45.0.1"
                        android:textColor="@color/text_primary_dark" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="TCP Fallback Port (if ICMP is dropped)"
                    android:textColorHint="@color/text_secondary_dark"
                    app:boxBackgroundColor="@color/background_dark"
                    app:boxStrokeColor="@color/accent_5g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGatewayTcpPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="5201"
                        android:textColor="@color/text_primary_dark" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. iperf3 Server Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iperf3 THROUGHPUT SERVER"
                    android:textColor="@color/accent_5g"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Server IP / Hostname"
                    android:textColorHint="@color/text_secondary_dark"
                    app:boxBackgroundColor="@color/background_dark"
                    app:boxStrokeColor="@color/accent_5g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIperfIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:text="192.168.1.100"
                        android:textColor="@color/text_primary_dark" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Port"
                        android:textColorHint="@color/text_secondary_dark"
                        app:boxBackgroundColor="@color/background_dark"
                        app:boxStrokeColor="@color/accent_5g">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIperfPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="5201"
                            android:textColor="@color/text_primary_dark" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Duration (sec)"
                        android:textColorHint="@color/text_secondary_dark"
                        app:boxBackgroundColor="@color/background_dark"
                        app:boxStrokeColor="@color/accent_5g">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIperfDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="10"
                            android:textColor="@color/text_primary_dark" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Drive Test Recording Intervals -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card_background_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOGGING FREQUENCIES"
                    android:textColor="@color/accent_5g"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Radio &amp; Location Sampling Interval"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerSampleInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/accent_5g" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Throughput (iperf3) Auto-Test Interval"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerThroughputInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/accent_5g" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/accent_5g"
            android:text="SAVE SETTINGS"
            android:textColor="@color/color_accent_button_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
